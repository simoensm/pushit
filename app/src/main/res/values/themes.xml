<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de base minimal — Compose gère tout le reste -->
    <style name="Theme.PushIt" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- UCrop dark theme — matches the app palette -->
    <style name="Theme.UCrop" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0D0D0F</item>
        <!-- Solid status/nav bars so UCrop toolbar renders BELOW them, not behind them -->
        <item name="android:statusBarColor">#0D0D0F</item>
        <item name="android:navigationBarColor">#0D0D0F</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Disable translucent bars — content starts below the status bar -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <!-- Ensure the system draws the status/nav bar backgrounds we set above -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Toolbar colour (AppCompat picks this up via colorPrimary) -->
        <item name="colorPrimary">#141416</item>
        <item name="colorPrimaryDark">#0D0D0F</item>
        <!-- Accent = green handles + active controls -->
        <item name="colorAccent">#1DB954</item>
    </style>
</resources>
