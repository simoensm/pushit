    <!-- Onboarding tour -->
    <string name="tour_skip">Skip</string>
    <string name="tour_next">Next</string>
    <string name="tour_done">Let\'s go!</string>

    <string name="tour_0_title">Welcome to PushIt!</string>
    <string name="tour_0_body">Hey, I\'m Leo — your training buddy. Let me show you around the app so you can start crushing it right away.</string>

    <string name="tour_1_title">Your rank</string>
    <string name="tour_1_body">This card shows your current rank tier and how many stars you have. Earn stars by doing reps, completing challenges, and keeping your streak alive!</string>

    <string name="tour_2_title">Daily goal and streak</string>
    <string name="tour_2_body">The ring fills up with today\'s reps toward your daily goal. The number next to it is your streak — consecutive active days. Don\'t break it!</string>

    <string name="tour_3_title">Start training</string>
    <string name="tour_3_body">Tap this button whenever you\'re ready to train. Set your phone facing you on the floor — the front camera will count every rep automatically!</string>

    <string name="tour_4_title">Challenges</string>
    <string name="tour_4_body">Weekly and monthly challenges push you to hit specific goals. Complete them to earn bonus stars and climb the ranks faster!</string>

    <string name="tour_5_title">Global rankings</string>
    <string name="tour_5_body">The Global tab ranks every PushIt player by total reps. Can you reach the top?</string>

    <string name="tour_6_title">Friends ranking</string>
    <string name="tour_6_body">Switch to Friends to see how you rank specifically against the people you know. Nothing like a bit of friendly competition!</string>

    <string name="tour_7_title">Add friends</string>
    <string name="tour_7_body">Tap the Add Friend button here, search by username, and start competing daily against your crew!</string>

    <string name="tour_8_title">Your profile</string>
    <string name="tour_8_body">Track your rank, achievements, and full session history right here. That\'s the tour — now go get those reps. I\'ll be cheering for you!</string>
