    <!-- Onboarding tour -->
    <string name="tour_skip">Passer</string>
    <string name="tour_next">Suivant</string>
    <string name="tour_done">C\'est parti !</string>

    <string name="tour_0_title">Bienvenue sur PushIt !</string>
    <string name="tour_0_body">Salut, moi c\'est Leo — ton partenaire d\'entraînement. Laisse-moi te faire une visite rapide de l\'app pour que tu puisses commencer à tout déchirer.</string>

    <string name="tour_1_title">Ton rang</string>
    <string name="tour_1_body">Cette carte montre ton niveau de rang actuel et ton nombre d\'étoiles. Gagne des étoiles en faisant des pompes, en relevant des défis et en maintenant ta série !</string>

    <string name="tour_2_title">Objectif du jour et série</string>
    <string name="tour_2_body">Le cercle se remplit avec les pompes du jour. Le chiffre à côté est ta série — les jours consécutifs d\'activité. Ne la brise pas !</string>

    <string name="tour_3_title">Commencer l\'entraînement</string>
    <string name="tour_3_body">Appuie sur ce bouton quand tu es prêt. Pose ton téléphone face à toi sur le sol — la caméra frontale comptera chaque pompe automatiquement !</string>

    <string name="tour_4_title">Défis</string>
    <string name="tour_4_body">Les défis hebdomadaires et mensuels te poussent à atteindre des objectifs précis. Complète-les pour gagner des étoiles bonus et monter en grade plus vite !</string>

    <string name="tour_5_title">Classement général</string>
    <string name="tour_5_body">L\'onglet Global classe tous les joueurs PushIt par nombre de pompes. Peux-tu atteindre le sommet ?</string>

    <string name="tour_6_title">Classement amis</string>
    <string name="tour_6_body">Bascule sur Amis pour voir ton rang spécifiquement parmi tes connaissances. Rien de tel qu\'une bonne compétition amicale !</string>

    <string name="tour_7_title">Ajouter des amis</string>
    <string name="tour_7_body">Appuie sur le bouton Ajouter ici, cherche par pseudo et commence à rivaliser chaque jour avec tes amis !</string>

    <string name="tour_8_title">Ton profil</string>
    <string name="tour_8_body">Suis ton rang, tes succès et tout ton historique juste ici. C\'est la fin de la visite — maintenant va chercher ces pompes. Je serai là pour t\'encourager !</string>
